{
  "name": "pauli-universe-video",
  "version": "0.0.1",
  "description": "Poly Universe: Cinema Studio + Where's Pauli Game + Creator Engine",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo build",
    "test": "turbo test",
    "test:coverage": "turbo test -- --coverage",
    "coverage-check": "node scripts/coverage-check.js",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "format": "turbo format",
    "format:check": "turbo format:check",
    "clean": "turbo clean && rm -rf node_modules pnpm-lock.yaml",
    "deploy": "turbo deploy",
    "dev": "turbo dev --parallel",
    "precommit": "lint-staged",
    "ralphie:loop": "bash scripts/ralphy-loop.sh",
    "deploy:production": "vercel deploy --prod"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.5.1",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "eslint": "^10.10.0",
    "eslint-config-next": "^16.3.5",
    "jest": "^30.5.1",
    "jest-environment-jsdom": "^30.5.1",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.6",
    "ts-jest": "^29.4.12",
    "turbo": "^2.9.14",
    "typescript": "^7.0.2"
  },
  "lint-staged": {
    "**/*.{ts,tsx,json,md}": [
      "prettier --write"
    ],
    "**/*.{ts,tsx}": [
      "eslint --fix"
    ]
  }
}
